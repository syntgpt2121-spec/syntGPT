# Server Configuration
PORT=3001

# Groq API Key (for AI chat features)
GROQ_API_KEY=<YOUR_GROQ_API_KEY>

# Google Custom Search API (OPTIONAL - 100 searches/day FREE)
# Get API Key: https://developers.google.com/custom-search/v1/overview
# Get Search Engine ID (cx): https://programmablesearchengine.google.com/
GOOGLE_API_KEY=<YOUR_GOOGLE_API_KEY>
GOOGLE_CX=<YOUR_SEARCH_ENGINE_ID>

# Tavily AI Search API (OPTIONAL - 1000 searches/month FREE, NO CREDIT CARD REQUIRED)
# Sign up at: https://tavily.com/ - just email, no payment needed
TAVILY_API_KEY=your_tavily_api_key_here

# Email SMTP Configuration
# For Gmail: Use App Password (not your regular password)
# Go to: Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Application Settings
APP_NAME=SyntGPT
FROM_EMAIL=syntgptt@gmail.com
